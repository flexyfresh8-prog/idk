# Discord AI bot config — fill these 3 in and you're done.

# User account token (NOT from the Developer Portal — extract it from
# Discord in a browser: F12 -> Network tab -> click any request -> copy
# the "authorization" header value)
DISCORD_USER_TOKEN=

# Free AI key from https://openrouter.ai/keys
AI_API_KEY=

# Discord user ID the bot talks to (right-click user -> Copy User ID
# with Developer Mode enabled in Discord settings)
TARGET_USER_ID=

# Optional — model and personality (defaults are fine)
# AI_MODEL=meta-llama/llama-3.2-3b-instruct:free
# SYSTEM_PROMPT=you are a casual person texting a friend on discord
