# ============================================================
# Discord SELF-BOT Configuration  (runs on a USER account)
# ============================================================
# !! ToS WARNING !!
# Automating a regular Discord user account violates Discord's Terms of
# Service. The account can be PERMANENTLY BANNED. Use a burner/alt account.
# ============================================================

# --- REQUIRED: USER ACCOUNT token (NOT a bot application token!) ---
# To extract your user token:
#   1. Open Discord in a desktop browser (Chrome/Firefox)
#   2. Press F12 to open DevTools
#   3. Go to Network tab, filter by "api"
#   4. Click any channel or send a message
#   5. Click any request to discord.com -> Headers tab
#   6. Find the "Authorization" request header -> copy the value
#   (DO NOT share this token with anyone — it gives full account access.)
DISCORD_USER_TOKEN=

# ============================================================
# AI Provider (pick one of: openrouter | huggingface | openai | custom)
# ============================================================
# You can configure more than one at the same time. The bot tries the primary
# provider, then its fallback models, then — if HUGGINGFACE_TOKEN is set — the
# Hugging Face router as a second free tier. A rate limit on one tier just
# moves the load to the next one instead of going silent.
AI_PROVIDER=openrouter

# API key for the chosen provider:
#   openrouter  -> https://openrouter.ai/keys (free tier available)
#   huggingface -> https://huggingface.co/settings/tokens (read access is enough)
#   openai      -> https://platform.openai.com/api-keys
AI_API_KEY=

# Hugging Face token — a SECOND free tier, used as failover when the primary
# provider is rate-limited or out of quota. The router only serves it once the
# account has inference credits (huggingface.co/settings/billing).
HUGGINGFACE_TOKEN=

# Fallback models tried on the SAME provider as the primary one, in order.
FALLBACK_MODELS=minimax/minimax-m3.1-flash:free,google/gemma-4-31b-it:free

# Models tried on the Hugging Face router when the token above is set.
HF_FALLBACK_MODELS=meta-llama/Llama-3.3-70B-Instruct,Qwen/Qwen3-32B

# AI model name (defaults per provider shown). Override here if you want a different one.
# OpenRouter free models (verified working, in order of preference):
#   poolside/laguna-s-2.1:free            (best all-rounder right now)
#   minimax/minimax-m3.1-flash:free        (fast, good chat)
#   google/gemma-4-31b-it:free             (good, but often rate-limited)
#   meta-llama/llama-3.3-70b-instruct:free (smart, slower)
#   qwen/qwen-3-8b:free                    (ok)
#
# Hugging Face models (router-based — needs inference credits on the account):
#   meta-llama/Llama-3.3-70B-Instruct
#   Qwen/Qwen3-32B
#   mistralai/Mistral-7B-Instruct-v0.3
AI_MODEL=poolside/laguna-s-2.1:free

# --- Advanced: override the base URL (only if AI_PROVIDER=custom) ---
# AI_BASE_URL=https://your-custom-endpoint/v1

# --- OpenRouter optional ranking headers ---
# OPENROUTER_REFERER=https://github.com/yourname/yourproject
# OPENROUTER_TITLE=Discord AI Self-Bot

# ============================================================
# Target User — the bot will respond to this user in ANY channel
# (no mention required) and !send will DM them.
#
# This must be the USER's id (right-click the person -> Copy User ID), not
# the id of the DM channel. If it is wrong, the bot says so in the log and
# falls back to the last person it was DM'd by.
#
# To find a user ID: enable Developer Mode in Discord (User Settings -> Advanced),
# then right-click a user -> Copy User ID.
TARGET_USER_ID=


# Optional: message the bot will DM the target user ONCE when it comes online.
# Leave empty to disable.
# Example: STARTUP_MESSAGE=Hey! I'm online and ready to chat.
STARTUP_MESSAGE=

# ============================================================
# Personality & Behavior
# ============================================================
# SYSTEM_PROMPT — leave EMPTY to use the built-in persona: a 15 year old girl
# who texts like a 2026 teen (lowercase, short, current Gen Z / Gen Alpha
# slang: rizz, delulu, ate, it's giving, no cap, hits different, ...).
# Set your own value here to override the whole voice.
SYSTEM_PROMPT=

MAX_HISTORY=10                  # messages remembered per channel
MAX_RESPONSE_CHARS=1900         # truncate AI replies to fit Discord's 2000-char limit
MAX_TOKENS=220                  # short replies are the human ones (and the fast ones)

# --- Response pacing (in seconds) ---
# The bot reads the message, thinks, then types it out. Raise these to make it
# slower; lower them to make it snappier.
#
# The model works WHILE the bot is thinking and typing, so the wait and the
# work overlap: the reply arrives roughly when the model is done, instead of
# think-time + generate-time + type-time added together.
THINK_BASE_SEC=0.8              # silent pause before the typing indicator appears
THINK_MAX_SEC=3.0               # cap on that pause
THINK_TAIL_SEC=6.0              # long tail — sometimes a person just sits on a message
TYPING_BASE_SEC=0.4             # minimum typing delay
TYPING_PER_CHAR_SEC=0.012       # extra delay per character (capped at TYPING_MAX_SEC)
TYPING_MAX_SEC=12.0             # maximum typing delay
JITTER_SEC=1.0                  # random variance, so no two replies take the same time

# --- Latency / reliability ---
AI_TIMEOUT_SEC=45               # a request that hangs this long is abandoned
AI_MAX_RETRIES=1                # retries on the SAME model (0 = fail over at once)
AI_STREAM=1                     # stream the reply so it starts arriving sooner
AI_COOLDOWN_SEC=900             # how long a rate-limited model is skipped for
TYPING_TAIL_MAX_SEC=3.0         # how long the typing indicator is held before sending

# --- Voice ---
SPLIT_MESSAGES=1                # send long replies as 2 messages, like a person
TEEN_STYLE=1                    # rewrite replies into teen texting style (lowercase, no apostrophes)
EMOJI_CHANCE=0.2                # chance (0-1) of adding a reaction emoji to a reply
REACTION_CHANCE=0.3             # chance (0-1) of a quick reaction BEFORE the reply ("no way", "stoppp")
TYPO_CHANCE=0.12                # chance (0-1) that a reply has one human typo in it
AI_TEMPERATURE=0.9              # higher = chattier and more slangy

# --- Human behaviour ---
# These decide whether the account reads as a person or as a bot.
REPLY_CHANCE=0.7                # chance of answering an eligible message (1.0 = answers everything)
REACT_ONLY_CHANCE=0.45          # when it does not reply, chance it drops an emoji reaction instead
USE_REACTIONS=1                 # use real Discord reactions (the little emoji under a message)
FOLLOWUP_CHANCE=0.15            # chance of a short second message after the real one
TYPING_PAUSE_CHANCE=0.35        # chance the typing indicator drops off mid-message
PING_REPLY_CHANCE=0.65          # send as a reply (ping) vs a plain message in the channel
DEBOUNCE_SEC=1.0                # messages sent within this window get ONE reply, not three
MAX_REPLIES_PER_MIN=6           # hard ceiling — above it the bot goes quiet like a person

# --- Auto-start / stability ---
# setup-startup.bat registers a scheduled task that starts supervisor.py at
# every logon. The supervisor restarts the app whenever it dies.
AUTO_START=1
AUTO_START_DELAY=3.0
AUTO_RESTART=1
AUTO_RESTART_DELAY=20.0
AUTO_RESTART_MAX=0              # 0 = never give up restarting the bot
AUTO_RESTART_BACKOFF_MAX=300.0  # longest wait between restart attempts

# --- Channel scope (optional) ---
# Comma-separated Discord channel IDs. Leave empty to allow all channels the bot can see.
# Example: CHANNEL_WHITELIST=123456789012345678,987654321098765432
CHANNEL_WHITELIST=
